# ===================================================================
# CalibrateSys Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real secrets or production passwords to version control!
# ===================================================================

# Active Spring Profile (e.g. dev or prod)
SPRING_PROFILES_ACTIVE=dev

# Application Port
PORT=8080

# Database Connectivity (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=calibrate_sys_db
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
# Optional full JDBC URL override:
# DB_URL=jdbc:mysql://localhost:3306/calibrate_sys_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Hibernate DDL Auto (update for development; validate for production)
HIBERNATE_DDL_AUTO=update

# Security & JWT Configuration
# JWT_SECRET must be at least 256 bits (32+ characters) Base64 or plain string
JWT_SECRET=your-secure-production-jwt-secret-key-minimum-256-bits-length-here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated origins; e.g. https://calibratesys.edu,https://app.calibratesys.edu)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Initial Admin Account Provisioning (set to false in production)
INIT_ADMIN_ENABLED=false
INIT_ADMIN_EMAIL=admin@calibratesys.edu
INIT_ADMIN_PASSWORD=change_this_admin_password
INIT_ADMIN_STAFF_ID=ADMIN-001

# Document Storage Path (Absolute path or relative path to application execution directory)
DOCUMENT_STORAGE_PATH=uploads/calibration-documents
DOCUMENTS_MAX_FILE_SIZE=10485760

# Calibration Scheduling Window (days before due date marked as UPCOMING)
CALIBRATION_UPCOMING_DAYS=30
